-- Books table schema
CREATE TABLE IF NOT EXISTS books (
    uuid TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    id INTEGER NOT NULL,
    rating REAL,
    data_json TEXT NOT NULL
);

-- Queries for books
upsertBook:
INSERT OR REPLACE INTO books(uuid, title, id, rating, data_json)
VALUES (?, ?, ?, ?, ?);

getAllBooks:
SELECT * FROM books ORDER BY title ASC;

getBookByUuid:
SELECT * FROM books WHERE uuid = ?;

deleteAllBooks:
DELETE FROM books;

deleteBook:
DELETE FROM books WHERE uuid = ?;

getBooksCount:
SELECT COUNT(*) FROM books;

