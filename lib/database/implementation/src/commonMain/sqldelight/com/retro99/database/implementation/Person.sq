-- ============================================
-- PERSONS TABLE (authors, narrators, creators)
-- ============================================

CREATE TABLE IF NOT EXISTS persons (
    uuid TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    file_as TEXT,
    created_at TEXT,
    updated_at TEXT
);

CREATE INDEX IF NOT EXISTS idx_persons_name ON persons(name);

-- Queries for persons
upsertPerson:
INSERT OR REPLACE INTO persons(uuid, name, file_as, created_at, updated_at)
VALUES (?, ?, ?, ?, ?);

getPersonByUuid:
SELECT * FROM persons WHERE uuid = ?;

getAllPersons:
SELECT * FROM persons ORDER BY name ASC;

searchPersonsByName:
SELECT * FROM persons WHERE name LIKE ? ORDER BY name ASC;

deletePerson:
DELETE FROM persons WHERE uuid = ?;

deleteAllPersons:
DELETE FROM persons;

